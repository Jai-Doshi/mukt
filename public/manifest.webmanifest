{
  "id": "./",
  "name": "Mukt · Education Loan Tracker",
  "short_name": "Mukt",
  "description": "Track your education loan: what you borrowed and from whom, every repayment and who made it, in two currencies with the exchange rate of the day. Private, offline, no account.",
